<Page x:Class="WinTune.App.Views.PerformancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*,Auto" Padding="32" RowSpacing="16">

        <StackPanel Grid.Row="0">
            <TextBlock Text="Rendimiento" Style="{StaticResource TitleLargeTextBlockStyle}"/>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Findings, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="16" Margin="0,4">
                        <Grid ColumnDefinitions="Auto,*">
                            <FontIcon Grid.Column="0" Glyph="&#xE9D9;" FontSize="20"
                                      Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Description}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <Button Content="Analizar" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ScanCommand}"/>
            <Button Content="Optimizar"
                    Command="{x:Bind ViewModel.ApplyCommand}"
                    IsEnabled="{x:Bind ViewModel.IsApplying, Converter={StaticResource NegatedBoolConverter}, Mode=OneWay}"/>
            <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="24" Height="24"/>
        </StackPanel>

    </Grid>
</Page>
