<Page x:Class="WinTune.App.Views.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:data="using:WinTune.Data">

    <Grid RowDefinitions="Auto,*,Auto" Padding="32" RowSpacing="16">

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Historial de Cambios" Style="{StaticResource TitleLargeTextBlockStyle}"/>
            <TextBlock Text="Registro de todas las optimizaciones aplicadas"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Empty state -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <FontIcon Glyph="&#xE81C;" FontSize="48"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="Sin cambios registrados aún"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Los cambios aplicados desde los módulos aparecerán aquí."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Entries list -->
        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                  SelectionMode="None"
                  Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource NegatedBoolToVisibilityConverter}, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="data:JournalEntry">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="16" Margin="0,4">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <!-- Kind badge -->
                            <Border Grid.Column="0" Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="6,2" VerticalAlignment="Top">
                                <TextBlock Text="{x:Bind Kind}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="White"/>
                            </Border>
                            <!-- Description + module -->
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Description}" FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ModuleId}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <!-- Date -->
                            <TextBlock Grid.Column="2" Text="{x:Bind AppliedAt}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <Button Content="Actualizar" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.RefreshCommand}"/>
        </StackPanel>
    </Grid>
</Page>
