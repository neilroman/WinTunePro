<Page x:Class="WinTune.App.Views.GamingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*,Auto" Padding="32" RowSpacing="16">

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Modo Gaming" Style="{StaticResource TitleLargeTextBlockStyle}"/>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Findings list -->
        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Findings, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="16" Margin="0,4">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Description}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Footer actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <Button Content="Escanear" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ScanCommand}"/>
            <Button Content="Aplicar"
                    Command="{x:Bind ViewModel.ApplyCommand}"
                    IsEnabled="{x:Bind ViewModel.IsApplying, Converter={StaticResource NegatedBoolConverter}, Mode=OneWay}"/>
            <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="24" Height="24"/>
            <TextBlock VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.EstimatedBytesSaved, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"/>
        </StackPanel>
    </Grid>
</Page>
