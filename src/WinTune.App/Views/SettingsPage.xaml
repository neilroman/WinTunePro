<Page x:Class="WinTune.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="24" MaxWidth="600">

            <TextBlock Text="Configuración" Style="{StaticResource TitleLargeTextBlockStyle}"/>

            <!-- Apariencia -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Apariencia" FontWeight="SemiBold"/>
                    <ComboBox Header="Tema" MinWidth="200"
                              SelectedIndex="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}">
                        <ComboBoxItem Content="Sistema (predeterminado)"/>
                        <ComboBoxItem Content="Claro"/>
                        <ComboBoxItem Content="Oscuro"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Notificaciones -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Notificaciones" FontWeight="SemiBold"/>
                    <ToggleSwitch Header="Alertas de problemas críticos"
                                  IsOn="{x:Bind ViewModel.NotificationsEnabled, Mode=TwoWay}"/>
                    <ToggleSwitch Header="Escaneo automático periódico"
                                  IsOn="{x:Bind ViewModel.AutoScanEnabled, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <!-- Seguridad -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Seguridad" FontWeight="SemiBold"/>
                    <TextBlock Text="Se crea un punto de restauración antes de aplicar cambios."
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"/>
                    <Button Content="Crear punto de restauración ahora"
                            Command="{x:Bind ViewModel.CreateRestorePointCommand}"/>
                    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Acerca de -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="WinTune Pro" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Versión 0.3.0 — Sprint 3A"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Licencia: GPL-3.0 — Sin telemetría, sin publicidad"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Guardar -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Guardar configuración" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SaveCommand}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
