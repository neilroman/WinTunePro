<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>WinTune.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13</LangVersion>
    <WindowsAppSdkVersion>2.4.0</WindowsAppSdkVersion>
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
  </PropertyGroup>

<ItemGroup>
    <ProjectReference Include="..\WinTune.Core\WinTune.Core.csproj" />
    <ProjectReference Include="..\WinTune.Broker.Contracts\WinTune.Broker.Contracts.csproj" />
    <ProjectReference Include="..\WinTune.Ai\WinTune.Ai.csproj" />
    <ProjectReference Include="..\plugins\WinTune.Plugins.Cleanup\WinTune.Plugins.Cleanup.csproj" />
    <ProjectReference Include="..\plugins\WinTune.Plugins.Performance\WinTune.Plugins.Performance.csproj" />
    <ProjectReference Include="..\plugins\WinTune.Plugins.Privacy\WinTune.Plugins.Privacy.csproj" />
    <ProjectReference Include="..\plugins\WinTune.Plugins.Gaming\WinTune.Plugins.Gaming.csproj" />
    <ProjectReference Include="..\plugins\WinTune.Plugins.Storage\WinTune.Plugins.Storage.csproj" />
    <ProjectReference Include="..\plugins\WinTune.Plugins.Network\WinTune.Plugins.Network.csproj" />
    <ProjectReference Include="..\plugins\WinTune.Plugins.Devtools\WinTune.Plugins.Devtools.csproj" />
    <ProjectReference Include="..\plugins\WinTune.Plugins.Power\WinTune.Plugins.Power.csproj" />
    <ProjectReference Include="..\plugins\WinTune.Plugins.Monitoring\WinTune.Plugins.Monitoring.csproj" />
    <ProjectReference Include="..\plugins\WinTune.Plugins.Backup\WinTune.Plugins.Backup.csproj" />
    <ProjectReference Include="..\WinTune.Monitor\WinTune.Monitor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.250402" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
